// LearnGrid data model — see docs (DATA_MODEL).
// `Profile.id` mirrors Supabase auth.users.id; populate it in the auth callback.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ClassStatus {
  DRAFT
  LISTED
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrolmentStatus {
  CONFIRMED
  CANCELLED
  REFUNDED
  ATTENDED
  NO_SHOW
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EarningStatus {
  PENDING_RELEASE
  RELEASED
  FROZEN
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  phone     String?
  avatarUrl String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherProfile TeacherProfile?
  classesTaught  Class[]         @relation("TeacherClasses")
  enrolments     Enrolment[]
  paymentsMade   Payment[]
  earnings       Earning[]
  payouts        Payout[]
  ratings        Rating[]
  notifications  Notification[]
}

model TeacherProfile {
  userId             String             @id @db.Uuid
  bio                String?
  subjectTags        String[]
  verificationStatus VerificationStatus @default(PENDING)
  docsUrl            String?
  bankAccountNumber  String?
  bankCode           String?
  bankAccountName    String?
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedBy         String?            @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model Class {
  id              String      @id @default(uuid()) @db.Uuid
  teacherId       String      @db.Uuid
  title           String
  subject         String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int
  seatLimit       Int
  seatsEnrolled   Int         @default(0)
  priceNgn        Int
  status          ClassStatus @default(DRAFT)
  sessionLink     String?
  startedAt       DateTime?
  endedAt         DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  teacher    Profile     @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrolments Enrolment[]
  payments   Payment[]
  earnings   Earning[]
  ratings    Rating[]

  @@index([status, scheduledAt])
  @@index([teacherId])
}

model Enrolment {
  id         String          @id @default(uuid()) @db.Uuid
  classId    String          @db.Uuid
  studentId  String          @db.Uuid
  paymentId  String?         @unique @db.Uuid
  status     EnrolmentStatus @default(CONFIRMED)
  enrolledAt DateTime        @default(now())

  class   Class    @relation(fields: [classId], references: [id])
  student Profile  @relation(fields: [studentId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([classId, studentId])
  @@index([studentId])
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  studentId    String        @db.Uuid
  classId      String        @db.Uuid
  amountNgn    Int
  paystackRef  String?       @unique
  status       PaymentStatus @default(INITIATED)
  failedAt     DateTime?
  failedReason String?
  refundedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student   Profile    @relation(fields: [studentId], references: [id])
  class     Class      @relation(fields: [classId], references: [id])
  enrolment Enrolment?

  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model Earning {
  id         String        @id @default(uuid()) @db.Uuid
  teacherId  String        @db.Uuid
  classId    String        @db.Uuid
  grossNgn   Int
  feeNgn     Int
  netNgn     Int
  status     EarningStatus @default(PENDING_RELEASE)
  releasedAt DateTime?
  payoutId   String?       @db.Uuid
  createdAt  DateTime      @default(now())

  teacher Profile @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  payout  Payout? @relation(fields: [payoutId], references: [id])

  @@index([teacherId, status])
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  teacherId    String       @db.Uuid
  amountNgn    Int
  status       PayoutStatus @default(PENDING)
  processedAt  DateTime?
  paystackRef  String?      @unique
  failedReason String?
  createdAt    DateTime     @default(now())

  teacher  Profile   @relation(fields: [teacherId], references: [id])
  earnings Earning[]

  @@index([teacherId])
}

model Rating {
  id          String   @id @default(uuid()) @db.Uuid
  classId     String   @db.Uuid
  studentId   String   @db.Uuid
  stars       Int
  comment     String?
  submittedAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id])
  student Profile @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  type        String
  payloadJson Json
  sentAt      DateTime  @default(now())
  readAt      DateTime?

  user Profile @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}
